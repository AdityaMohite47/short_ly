# Copy to .env.docker and fill in. Used by: docker compose --env-file .env.docker up
POSTGRES_USER=username
POSTGRES_PASSWORD=change-me
POSTGRES_DB=dbnames

CODE_MAX_RETRIES=5
CACHE_TTL=24

# The address people type in the browser. Short links are built from it.
# Locally: http://localhost:8080   On the server: https://<subdomain>.<domain>.in
PUBLIC_URL=http://localhost:8080

# Port on 127.0.0.1 where the app listens. The host nginx proxies to this port, so it
# must be free on the server and match proxy_pass in deploy/host-nginx.conf.
WEB_PORT=8080
